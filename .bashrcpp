#!/usr/bin/env bash
# Source this file in .bashrc by adding
# . ~/.bashrcpp

## History file setup.
# If in a tmux environment, save history per pane. Basic terminal window history is saved like normal in .bash_history

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=-1
HISTFILESIZE=-1
# append to the history file, don't overwrite it
shopt -s histappend
PROMPT_COMMAND+=("history -a")

# Set tmux pane history etc if tmux is installed.
if hash tmux >/dev/null 2>&1
then
    TMUX_HISTDICT=$HOME/.history
    mkdir -p $TMUX_HISTDICT
    if [[ $TMUX_PANE ]]; then
        pane_title_prefix="!!"
        pane_title=$(tmux display -pt "${TMUX_PANE}" "#{pane_title}")
        # Check if we've already set this pane title
        if [[ "$pane_title" != "$pane_title_prefix"* ]]; then
            # Find next free pane index
            pane_count=$(($(tmux list-panes | wc -l) - 1))
            # Fetch all pane titles
            pane_titles=$(tmux list-panes -F "#{pane_title}#")
            # Loop from 0 up to find the next available gap.
            for (( i=0; i<=$pane_count; i++ ));{
                if [[ "$pane_titles" != *"$pane_title_prefix$i#"* ]]; then
                    break
                fi
            }
            title="$pane_title_prefix$i"
            printf "\033]2;$title\033\\"
        fi
        # History file is . + session name + pane title
        # Example: ".mysession!!0"
        HISTFILE=$TMUX_HISTDICT/.$(tmux display -pt "${TMUX_PANE}" "#S#T")
    fi
    
    # Add tmuxs command with tab completion of existing sessions
    tmuxs ()
    {
        if [ -z "$1" ]; then
            tmux new-session -A -s init
        else
            tmux new-session -A -s "$1"
        fi
    }
    
    _tmuxls()
    {
        local cur
        cur=${COMP_WORDS[COMP_CWORD]}
        COMPREPLY=($( compgen -W "$(tmux ls -F "#{session_name}")" -- $cur ) )
    }
    complete -F _tmuxls tmuxs
fi

# Function for adding entries to PATH without setting duplicates
function toPATH {
  case ":$PATH:" in
    *":$1:"*) :;; # already there
    *) PATH="$1:$PATH";; # or PATH="$PATH:$1"
  esac
}

ctrlr() {
    (cd $TMUX_HISTDICT && grep -ri "${1}")
}
alias cr=ctrlr

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac
## Improved colors. Blue folder names on black sucks.
# Better colors than standard ubuntu
if [ "$color_prompt" = yes ]; then
    # PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;32m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
LS_COLORS="$LS_COLORS:di=0;32:ow=40;36;01"

unset color_prompt force_color_prompt

# Make dir and cd into it
mkcd ()
{
  mkdir -p -- "$1" &&
     cd -P -- "$1"
}

# cd into a dir and run ls
cl ()
{
  if [ -z "$1" ]; then
    ls .
  else
    cd -P -- "$1" &&
    ls .
  fi
}

# cd into a dir and run ll
cll ()
{
  if [ -z "$1" ]; then
    ll .
  else
    cd -P -- "$1" &&
    ll .
  fi
}

# autocorrections
alias cd..='cd ..'

## dev commands
# Enable tab completion in .dev-completion.bash
DEV_BASEPATH=~/projects/code

# Create dev folders
mkdir -p "$DEV_BASEPATH"/workspaces
mkdir -p "$DEV_BASEPATH"/venvs

# Select development environment
devr ()
{
    cd -P -- "$DEV_BASEPATH"/workspaces/"$1"
}
dev ()
{
    devr "$1"
    if [ -f goto ]; then
        . goto
    fi
}
# Select development environment and python venv
devv ()
{
    if [ -f "$DEV_BASEPATH"/venvs/"$1"/bin/activate ]; then
        . "$DEV_BASEPATH"/venvs/"$1"/bin/activate
    fi
    dev "$1"
}

# Create development environment
mkdev ()
{
    if [ "$1" ]; then
        mkdir "$DEV_BASEPATH"/workspaces/"$1" &&
        cd -P -- "$DEV_BASEPATH"/workspaces/"$1"
    else
        echo "Empty name supplied..."
    fi
}

# Create development environment and python venv
mkdevv ()
{
    if [ "$1" ]; then
        python3 -m venv "$DEV_BASEPATH"/venvs/"$1" &&
        . "$DEV_BASEPATH"/venvs/"$1"/bin/activate &&
        mkdev "$1"
    else
        echo "Empty name supplied..."
    fi
}

# Remove development environment
rmdev ()
{
    cd "$DEV_BASEPATH"/workspaces
    if [ -d "$DEV_BASEPATH"/venvs/"$1" ]; then
        deactivate &&
        rm -rf "$DEV_BASEPATH"/venvs/"$1"
    fi
    rm -rf "$DEV_BASEPATH"/workspaces/"$1"
}

# Add tab completion to dev commands
. ~/.dev-completion.bash

# Open code workspace in this folder or the one above
codew ()
{
    myarray=(`find ./ -maxdepth 1 -name "*.code-workspace"`)
    if [ ${#myarray[@]} -eq 0 ]; then
        myarray=(`find ../ -maxdepth 1 -name "*.code-workspace"`)
    fi
    echo ${myarray}
    code ${myarray[0]}
}
alias cw='codew'

# Open workspace in zed, from any place in the workspace
zedw ()
{
    if [[ $PWD/ =~ (.*/workspaces/[^/]*).*/ ]]; then
        echo ${BASH_REMATCH[1]}
        zed ${BASH_REMATCH[1]}
    else
        echo "No workspace found"
        zed .
    fi
}
alias zw='zedw'
# Open zed "here" quick
alias zz='zed .'

# set XON/XOFF active
[[ $- == *i* ]] && stty -ixon

# Fix password entry for gpg signing over ssh
# sudo update-alternatives --config pinentry
#   select pinentry-curses
# gpg-connect-agent reloadagent /bye
export GPG_TTY=$(tty)

# git aliases
if [ -f ~/.git_aliases ]; then
    . ~/.git_aliases
fi
gh ()
{
    if [ -f ~/.git_aliases ]; then
        cat ~/.git_aliases
    else
        echo "git_aliases not installed"
    fi
}

# Keep secret keys in ~/.bashrc-secrets to stop them from leaking into history.
# They are still saved in clear text, but will not be visible at least...
if [ -f ~/.bashrc-secrets ]; then
    . ~/.bashrc-secrets
fi

alias rrc='. ~/.bashrc;echo "Reloaded ~/.bashrc"'
